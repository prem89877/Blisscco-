# Supabase > Project Settings > API. Use ONLY the anon/public key here.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ---------------- Phase 8: SERVER-ONLY (set in Vercel > Settings > Environment Variables, NOT in .env.local for the browser) ----------------
# Never prefix these with VITE_. Mark the two secrets as "Sensitive" in Vercel.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx            (public id, shown to the browser by /api/create-order)
# RAZORPAY_KEY_SECRET=xxxxxxxx                 (SENSITIVE)
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx             (SENSITIVE - the secret you type when creating the webhook in Razorpay)
# SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx           (SENSITIVE - Supabase > Project Settings > API > service_role)
# SUPABASE_URL / SUPABASE_ANON_KEY are optional: the API routes fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.

# ---------------- Phase 9: AI insights (SERVER-ONLY, ELITE feature) ----------------
# AI_API_KEY=xxxxxxxx                          (SENSITIVE - key from your AI provider)
# AI_PROVIDER=anthropic                        ('anthropic' = default, or 'openai' for any OpenAI-compatible API)
# AI_MODEL=                                    (optional for anthropic; REQUIRED for openai)
# AI_BASE_URL=                                 (optional; only for OpenAI-compatible providers other than OpenAI)
# Without AI_API_KEY the AI card shows "Configuration required" and no answer is generated.

# ---------------- Phase 10: Notifications + PWA ----------------
# Browser (public, safe to expose). Put in Vercel AND .env for local builds:
# VITE_VAPID_PUBLIC_KEY=BXXXXXXXX...           (the PUBLIC half of your VAPID key pair)
# Server-only (Vercel > Settings > Environment Variables). Mark the secrets "Sensitive":
# VAPID_PRIVATE_KEY=xxxxxxxx                   (SENSITIVE - the PRIVATE half; never VITE_)
# VAPID_SUBJECT=mailto:you@yourdomain.com      (a contact the push services can reach)
# RESEND_API_KEY=re_xxxxxxxx                   (SENSITIVE - Resend > API Keys)
# RESEND_FROM=Blisscco <notifications@yourdomain.com>   (must be on a domain you verified in Resend)
# NOTIFY_CRON_SECRET=a-long-random-string      (SENSITIVE - same value you store in Supabase notification_config)
# SITE_URL=https://your-site.vercel.app        (used for the "Open Blisscco" button in emails)
