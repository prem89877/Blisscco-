# Supabase > Project Settings > API. Use ONLY the anon/public key here.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ---------------- Phase 8: SERVER-ONLY (set in Vercel > Settings > Environment Variables, NOT in .env.local for the browser) ----------------
# Never prefix these with VITE_. Mark the secrets as "Sensitive" in Vercel.
# CASHFREE_APP_ID=xxxxxxxx                     (Cashfree Dashboard > Developers > API Keys: the App ID / Client ID)
# CASHFREE_SECRET_KEY=xxxxxxxx                 (SENSITIVE - the Secret Key. Also used to verify webhook signatures; there is no separate webhook secret)
# CASHFREE_ENV=sandbox                         (optional: 'sandbox' is the default. Set to 'production' ONLY when you switch to live keys)
# SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx           (SENSITIVE - Supabase > Project Settings > API > service_role)
# SUPABASE_URL / SUPABASE_ANON_KEY are optional: the API routes fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.

# ---------------- Phase 9: AI insights (SERVER-ONLY, ELITE feature) ----------------
# AI_API_KEY=xxxxxxxx                          (SENSITIVE - key from your AI provider)
# AI_PROVIDER=anthropic                        ('anthropic' = default, or 'openai' for any OpenAI-compatible API)
# AI_MODEL=                                    (optional for anthropic; REQUIRED for openai)
# AI_BASE_URL=                                 (optional; only for OpenAI-compatible providers other than OpenAI)
# Without AI_API_KEY the AI card shows "Configuration required" and no answer is generated.

# ---------------- Phase 10: Notifications + PWA ----------------
# Browser (public, safe to expose). Put in Vercel AND .env for local builds:
# VITE_VAPID_PUBLIC_KEY=BXXXXXXXX...           (the PUBLIC half of your VAPID key pair)
# Server-only (Vercel > Settings > Environment Variables). Mark the secrets "Sensitive":
# VAPID_PRIVATE_KEY=xxxxxxxx                   (SENSITIVE - the PRIVATE half; never VITE_)
# VAPID_SUBJECT=mailto:you@yourdomain.com      (a contact the push services can reach)
# RESEND_API_KEY=re_xxxxxxxx                   (SENSITIVE - Resend > API Keys)
# RESEND_FROM=Blisscco <notifications@yourdomain.com>   (must be on a domain you verified in Resend)
# NOTIFY_CRON_SECRET=a-long-random-string      (SENSITIVE - same value you store in Supabase notification_config)
# SITE_URL=https://your-site.vercel.app        (used for the "Open Blisscco" button in emails, and by robots.txt / sitemap.xml / link-preview image at build time)
# VITE_SITE_URL=https://your-site.vercel.app   (browser: canonical + Open Graph URLs. Same value as SITE_URL; without it the page's own address is used)

# ---------------- Navigation (Part 1): in-website map + routing. All optional, sensible defaults are built in ----------------
# Browser (public). The default tile server is the free public OpenStreetMap one: OK for testing, NOT for heavy production traffic.
# Before launch, point this at a tile provider you are allowed to use at scale (paid host or your own tile server) and set its attribution:
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# VITE_MAP_TILE_MAX_ZOOM=19
# Server-only (Vercel > Settings > Environment Variables). Routing and geocoding run through /api/route and /api/geocode so keys never reach the browser:
# ROUTING_PROVIDER=osrm                        ('osrm' is the only built-in provider; add others in api/_lib/routing.ts)
# OSRM_BASE_URL=https://router.project-osrm.org  (public DEMO server: testing only. Use your own OSRM or a paid host in production)
# OSRM_PROFILE=driving
# GEOCODER_PROVIDER=nominatim                  (only used when a shop has no valid saved coordinates)
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=Blisscco/1.0 (you@yourdomain.com)   (Nominatim requires an identifying User-Agent with a contact)

